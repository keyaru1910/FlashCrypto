{
  "name": "flashcrypto",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time Crypto Price & Candlestick Dashboard",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "prisma generate --schema=libs/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=libs/db/prisma/schema.prisma",
    "db:seed": "tsx libs/db/prisma/seed.ts",
    "db:studio": "prisma studio --schema=libs/db/prisma/schema.prisma",
    "ingest:dev": "npm run --workspace=apps/ingest dev",
    "worker:dev": "npm run --workspace=apps/worker dev",
    "api:dev": "npm run --workspace=apps/api dev",
    "web:dev": "npm run --workspace=apps/web dev"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  }
}
