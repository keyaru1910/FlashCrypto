{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@flashcrypto/market-data": ["libs/market-data/src"],
      "@flashcrypto/redis-keys": ["libs/redis-keys/src"],
      "@flashcrypto/db": ["libs/db/src"]
    }
  }
}
